{
  "name": "interview-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Interview Agent — Express backend exposing POST /api/interview",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/test-backend.mjs",
    "verify": "MOCK_LLM=1 node scripts/verify-interviews.mjs",
    "verify:advance": "MOCK_LLM=1 MOCK_ACTION=advance node scripts/verify-interviews.mjs",
    "verify:followup": "MOCK_LLM=1 MOCK_ACTION=followup node scripts/verify-interviews.mjs",
    "verify:groq": "LIMIT=2 node scripts/verify-interviews.mjs",
    "smoke": "node scripts/smoke-remote.mjs",
    "demo": "MOCK_LLM=1 node scripts/demo-interview.mjs",
    "demo:live": "node scripts/demo-interview.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "groq-sdk": "^0.37.0"
  }
}
