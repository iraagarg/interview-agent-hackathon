# Copy to .env and fill in. Never commit .env — it is gitignored.

# Groq API key — https://console.groq.com/keys
# Required. The server refuses to start without it.
GROQ_API_KEY=gsk_your_key_here

# Groq model used for question generation, answer grading and final feedback.
# Must be a model that supports JSON-mode responses.
GROQ_MODEL=llama-3.3-70b-versatile

# Groq rate-limits per model, so a second model carries its own daily token
# budget. When the primary is exhausted the interview keeps generating real
# questions on this one instead of dropping to scripted fallbacks.
# Set to an empty value to disable.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Port the Express server listens on.
# Render/Railway inject their own PORT — do not hardcode it there.
PORT=8080

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is the Vite dev server. After deploying the frontend,
# add its Vercel URL here, e.g.
#   CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Use * to allow any origin (fine for a no-auth hackathon demo).
CORS_ORIGINS=http://localhost:5173
