# Copy to .env.local for local dev. Vite only exposes vars prefixed with VITE_.

# Base URL of the Express backend, with no trailing slash.
# Local:      http://localhost:8080
# Production: https://your-service.onrender.com
# Set this in the Vercel project's Environment Variables too — it is baked in
# at build time, so changing it requires a redeploy, not just a restart.
VITE_API_BASE_URL=http://localhost:8080
